+  ['F51 replay: SDD S-O1 seam row holds closure-report cells', () => edit('spec/sdd-service.md', (s) => s.replace(/^(\| \*\*S-O1\*\* \*\([^)]*\)\* \|).*$/m, '$1 FC-X | crossing examples, §8 | integration | §14.4 |'))],
