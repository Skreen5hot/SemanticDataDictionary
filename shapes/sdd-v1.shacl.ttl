# SHACL shapes for the SDD SemanticDataDictionary (SDD OS-1, ADR-006). SHACL Core only (no SPARQL constraints).
#
# Data graph: a SemanticDataDictionary JSON-LD file expanded through context/sdd-v1.jsonld. Under that context the
# document node is typed sdd:SemanticDataDictionary; mappings, sources, provenance and acceptance records are blank
# nodes; recordClass, referentClass, iceClass, relation, datatype, valueProperty and contextIri are IRIs; at is an
# xsd:dateTime literal; sddVersion and round are xsd:integer literals; every other value is an xsd:string literal.
# JSON arrays without @list are unordered sets, and JSON nulls and empty arrays produce no triple.
#
# Term closure (R-S5, R-S7, V-S6) is stated against the bundled term list pinned in sddsh:EnvironmentShape
# (terms_sha256 a9e01756, Ontology-Template 114f28db):
#   sddsh:InformationContentEntityClass = cco:ont00000958 and its permitted named descendants (130),
#   sddsh:PermittedClass = every permitted class (1421),
#   sddsh:PermittedObjectProperty = every permitted object property (265).
# These are the R-S11 CATALOGUE sections. src/test/schemas.mjs re-derives them from ontology/term-list.json and fails
# on any drift. An SDD that records another term list does not conform: these lists cannot check it (R-S17, SDD-F72).
#
# Not expressible in SHACL Core on this graph alone (left to C-S4 and to the JSON Schema schemas/sdd-v1.schema.json):
# domain and range (R-S8; it joins a relation to the owner's and target's type mappings by key string); uniqueness of
# mapping keys; key = "ct:" + child; array order and sortedness (arrays are sets in RDF); presence of an empty
# nullEquivalents (an empty array yields no triple).

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sdd: <https://skreen5hot.github.io/SemanticDataDictionary/ns#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix sddsh: <https://skreen5hot.github.io/SemanticDataDictionary/shapes/sdd-v1#> .

# The dictionary (R-S15 absence kinds; R-S17 a key is mapped or open, never both).
sddsh:SemanticDataDictionaryShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:targetClass sdd:SemanticDataDictionary ;
  sh:targetSubjectsOf sdd:sddVersion, sdd:absenceKinds, sdd:mappings ;
  sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue sdd:SemanticDataDictionary ] ;
  sh:property [ sh:path sdd:sddVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:hasValue 1 ] ;
  sh:property [ sh:path sdd:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:DictionarySourceShape ] ;
  sh:property [ sh:path sdd:environment ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:EnvironmentShape ] ;
  sh:property [ sh:path sdd:absenceKinds ; sh:minCount 4 ; sh:maxCount 4 ; sh:datatype xsd:string ;
    sh:in ( "missing" "explicit_null" "empty_string" "indistinguishable" ) ] ;
  sh:property [ sh:path sdd:mappings ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:MappingShape ] ;
  sh:property [ sh:path sdd:open ; sh:datatype xsd:string ; sh:pattern "^(ot:([^~/]|~[01])*|at:([^~/]|~[01])*(/([^~/]|~[01])*)?|ct:ot:([^~/]|~[01])*)$" ] ;
  sh:property [ sh:path sdd:retired ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:MappingShape ] ;
  sh:property [ sh:path ( sdd:mappings sdd:key ) ; sh:disjoint sdd:open ] ;
  sh:node sddsh:IdentificationShape ;
.

# R-S2: identification "name" means no item has an externalId; "externalId" means every item does (containment
# mappings have none). Current mappings only: a retired mapping keeps the source of the act that accepted it.
sddsh:IdentificationShape
  a sh:NodeShape ;
  sh:or (
    [ sh:property [ sh:path ( sdd:source sdd:identification ) ; sh:hasValue "name" ] ;
      sh:property [ sh:path ( sdd:mappings sdd:source sdd:externalId ) ; sh:maxCount 0 ] ]
    [ sh:property [ sh:path ( sdd:source sdd:identification ) ; sh:hasValue "externalId" ] ;
      sh:property [ sh:path sdd:mappings ; sh:node sddsh:HasExternalIdShape ] ]
    [ sh:property [ sh:path ( sdd:source sdd:identification ) ; sh:hasValue "mixed" ] ]
  ) .

sddsh:HasExternalIdShape
  a sh:NodeShape ;
  sh:or (
    [ sh:property [ sh:path sdd:kind ; sh:hasValue "containment" ] ]
    [ sh:property [ sh:path ( sdd:source sdd:externalId ) ; sh:minCount 1 ] ]
  ) .

# The schema the dictionary was made from.
sddsh:DictionarySourceShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:format ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:hasValue "jira-assets-import/2021_09_15" ] ;
  sh:property [ sh:path sdd:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path sdd:schemaName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:identification ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "name" "externalId" "mixed" ) ] ;
  sh:property [ sh:path sdd:inventorySha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
.

# The pins the dictionary was made under: the term list these shapes were generated from.
sddsh:EnvironmentShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:termListSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "a9e01756d749655a53088833bb97612791caf9a19220065848c826f99985cd39" ] ;
  sh:property [ sh:path sdd:ontologyTemplateCommit ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "114f28db82adf727f5e31aab4872ed56550e84af" ] ;
  sh:property [ sh:path sdd:contextIri ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue <https://skreen5hot.github.io/SemanticDataDictionary/context/sdd-v1.jsonld> ] ;
.

# A mapping (in mappings or retired) is exactly one of the four kinds.
sddsh:MappingShape
  a sh:NodeShape ;
  sh:property [ sh:path sdd:key ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:kind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "type" "attribute" "reference" "containment" ) ] ;
  sh:xone ( sddsh:TypeMappingShape sddsh:AttributeMappingShape sddsh:ReferenceMappingShape sddsh:ContainmentMappingShape ) .

# Object type (R-S5: recordClass is ICE-descended; R-S7: referentClass is a permitted class).
sddsh:TypeMappingShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:key ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^ot:([^~/]|~[01])*$" ] ;
  sh:property [ sh:path sdd:kind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "type" ] ;
  sh:property [ sh:path sdd:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:TypeSourceShape ] ;
  sh:property [ sh:path sdd:recordClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:node sddsh:InformationContentEntityClass ] ;
  sh:property [ sh:path sdd:referentClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:node sddsh:PermittedClass ] ;
  sh:property [ sh:path sdd:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:provenance ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:ProvenanceShape ] ;
  sh:property [ sh:path sdd:acceptance ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:AcceptanceShape ] ;
.

# Attribute (R-S5 iceClass; R-S9 datatype and valueProperty by Jira type; R-S15 nullEquivalents).
sddsh:AttributeMappingShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:key ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^at:([^~/]|~[01])*(/([^~/]|~[01])*)?$" ] ;
  sh:property [ sh:path sdd:kind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "attribute" ] ;
  sh:property [ sh:path sdd:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:AttributeSourceShape ] ;
  sh:property [ sh:path sdd:iceClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:node sddsh:InformationContentEntityClass ] ;
  sh:property [ sh:path sdd:datatype ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in ( xsd:string xsd:anyURI xsd:integer xsd:double xsd:boolean xsd:date xsd:dateTime ) ] ;
  sh:property [ sh:path sdd:valueProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in ( cco:ont00001765 cco:ont00001768 cco:ont00001773 cco:ont00001770 cco:ont00001772 cco:ont00001771 cco:ont00001767 ) ] ;
  sh:property [ sh:path sdd:nullEquivalents ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:provenance ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:ProvenanceShape ] ;
  sh:property [ sh:path sdd:acceptance ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:AcceptanceShape ] ;
  sh:node sddsh:ValueTableShape ;
.

# Reference (R-S7: relation is a permitted object property; sdd:NoRelation is not admitted).
sddsh:ReferenceMappingShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:key ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^at:([^~/]|~[01])*(/([^~/]|~[01])*)?$" ] ;
  sh:property [ sh:path sdd:kind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "reference" ] ;
  sh:property [ sh:path sdd:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:ReferenceSourceShape ] ;
  sh:property [ sh:path sdd:relation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:node sddsh:PermittedObjectProperty ] ;
  sh:property [ sh:path sdd:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:provenance ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:ProvenanceShape ] ;
  sh:property [ sh:path sdd:acceptance ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:AcceptanceShape ] ;
.

# Containment (R-S7: a permitted object property, or sdd:NoRelation, which only containment admits).
sddsh:ContainmentMappingShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:key ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^ct:ot:([^~/]|~[01])*$" ] ;
  sh:property [ sh:path sdd:kind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "containment" ] ;
  sh:property [ sh:path sdd:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:ContainmentSourceShape ] ;
  sh:property [ sh:path sdd:relation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:or ( sddsh:PermittedObjectProperty [ sh:in ( sdd:NoRelation ) ] ) ] ;
  sh:property [ sh:path sdd:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:provenance ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:ProvenanceShape ] ;
  sh:property [ sh:path sdd:acceptance ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node sddsh:AcceptanceShape ] ;
.

# R-S9 value table: datatype and valueProperty are fixed by the source Jira type.
sddsh:ValueTableShape
  a sh:NodeShape ;
  sh:or (
    [ sh:property [ sh:path ( sdd:source sdd:jiraType ) ; sh:minCount 1 ; sh:in ( "text" "textarea" "email" "select" "ipaddress" "time" ) ] ;
      sh:property [ sh:path sdd:datatype ; sh:hasValue xsd:string ] ;
      sh:property [ sh:path sdd:valueProperty ; sh:hasValue cco:ont00001765 ] ]
    [ sh:property [ sh:path ( sdd:source sdd:jiraType ) ; sh:minCount 1 ; sh:in ( "url" ) ] ;
      sh:property [ sh:path sdd:datatype ; sh:hasValue xsd:anyURI ] ;
      sh:property [ sh:path sdd:valueProperty ; sh:hasValue cco:ont00001768 ] ]
    [ sh:property [ sh:path ( sdd:source sdd:jiraType ) ; sh:minCount 1 ; sh:in ( "integer" ) ] ;
      sh:property [ sh:path sdd:datatype ; sh:hasValue xsd:integer ] ;
      sh:property [ sh:path sdd:valueProperty ; sh:hasValue cco:ont00001773 ] ]
    [ sh:property [ sh:path ( sdd:source sdd:jiraType ) ; sh:minCount 1 ; sh:in ( "double" ) ] ;
      sh:property [ sh:path sdd:datatype ; sh:hasValue xsd:double ] ;
      sh:property [ sh:path sdd:valueProperty ; sh:hasValue cco:ont00001770 ] ]
    [ sh:property [ sh:path ( sdd:source sdd:jiraType ) ; sh:minCount 1 ; sh:in ( "boolean" ) ] ;
      sh:property [ sh:path sdd:datatype ; sh:hasValue xsd:boolean ] ;
      sh:property [ sh:path sdd:valueProperty ; sh:hasValue cco:ont00001772 ] ]
    [ sh:property [ sh:path ( sdd:source sdd:jiraType ) ; sh:minCount 1 ; sh:in ( "date" ) ] ;
      sh:property [ sh:path sdd:datatype ; sh:hasValue xsd:date ] ;
      sh:property [ sh:path sdd:valueProperty ; sh:hasValue cco:ont00001771 ] ]
    [ sh:property [ sh:path ( sdd:source sdd:jiraType ) ; sh:minCount 1 ; sh:in ( "date_time" ) ] ;
      sh:property [ sh:path sdd:datatype ; sh:hasValue xsd:dateTime ] ;
      sh:property [ sh:path sdd:valueProperty ; sh:hasValue cco:ont00001767 ] ]
  ) .

# Source of a type mapping.
sddsh:TypeSourceShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:externalId ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:itemSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
.

# Source of an attribute mapping.
sddsh:AttributeSourceShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:externalId ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:owner ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^ot:([^~/]|~[01])*$" ] ;
  sh:property [ sh:path sdd:jiraType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "text" "textarea" "integer" "double" "boolean" "date" "time" "date_time" "url" "email" "select" "ipaddress" ) ] ;
  sh:property [ sh:path sdd:itemSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
.

# Source of a reference mapping.
sddsh:ReferenceSourceShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:externalId ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path sdd:owner ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^ot:([^~/]|~[01])*$" ] ;
  sh:property [ sh:path sdd:jiraType ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "referenced_object" ] ;
  sh:property [ sh:path sdd:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^ot:([^~/]|~[01])*$" ] ;
  sh:property [ sh:path sdd:itemSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
.

# Source of a containment mapping (its FL-CONTAINMENT flag).
sddsh:ContainmentSourceShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:child ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^ot:([^~/]|~[01])*$" ] ;
  sh:property [ sh:path sdd:container ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^ot:([^~/]|~[01])*$" ] ;
  sh:property [ sh:path sdd:selector ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path sdd:itemSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
.

# The validated check a mapping came from (R-S18).
sddsh:ProvenanceShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:round ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
  sh:property [ sh:path sdd:batch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[1-9][0-9]*/[1-9][0-9]*$" ] ;
  sh:property [ sh:path sdd:promptSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path sdd:proposalSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path sdd:checkReportSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
.

# The acceptance record (R-S14: only C-S6 output carries one; NG-S5: by is verbatim; at is UTC to the second; the JSON Schema fixes the Z form, and +00:00 is admitted here because some RDF stores rewrite the lexical form of xsd:dateTime literals).
sddsh:AcceptanceShape
  a sh:NodeShape ;
  sh:closed true ;
  sh:property [ sh:path sdd:decision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:hasValue "accepted" ] ;
  sh:property [ sh:path sdd:by ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path sdd:at ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](Z|[+]00:00)$" ] ;
.

